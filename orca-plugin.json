{
  "manifestVersion": 2,
  "id": "android-devtools",
  "name": "Android Devtools",
  "version": "0.1.0",
  "description": "Run Android Gradle variants on connected devices from Orca or the Node CLI.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "android-devtools",
        "title": "Android Devtools",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "android-devtools.run",
        "title": "Android Devtools: Run Selected Project",
        "when": "workspace"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "storage:own"
    }
  ]
}
